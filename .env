# Weather Sentinel AI Environment Configuration

# Server & Network Ports
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB or In-Memory fallback)
# Set to 'mongodb://localhost:27017/weather_sentinel_ai' when MongoDB is installed
# If MongoDB is not running, the application automatically uses the embedded high-performance In-Memory Datastore.
MONGO_URI=mongodb://localhost:27017/weather_sentinel_ai
USE_IN_MEMORY=false

# Authentication
JWT_SECRET=weather-sentinel-ultra-secret-jwt-key-sih-2026
JWT_EXPIRES_IN=7d

# Machine Learning Service Integration
# Mode: 'mock' (Deterministic embedded engine for 100% reliable demo) or 'python' (FastAPI REST service)
MODEL_MODE=mock
ML_SERVICE_URL=http://localhost:8000
